# Copy to .env and fill in. Both are safe to ship to the browser.
# Leave them blank to run fully offline with the built-in stall list (no ratings).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The Google Places key is NOT a VITE_ variable on purpose. It lives only in
# Supabase secrets:  supabase secrets set GOOGLE_PLACES_API_KEY=...
